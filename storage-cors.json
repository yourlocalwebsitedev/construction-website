[
  {
    "origin": ["*"],
    "method": ["GET", "PUT", "POST", "HEAD"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Content-Type",
      "Content-Range",
      "Content-Length",
      "X-Goog-Upload-Command",
      "X-Goog-Upload-Protocol",
      "X-Goog-Upload-Offset",
      "X-Goog-Upload-Status",
      "X-Goog-Upload-URL"
    ]
  }
]
